{
  "name": "agent-skill-loader",
  "version": "1.2.1",
  "mcpName": "io.github.back1ply/agent-skill-loader",
  "type": "module",
  "description": "MCP Server to expose Claude Code Skills to agents",
  "main": "build/index.js",
  "bin": {
    "agent-skill-loader": "build/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "skills",
    "claude"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "probe": "npx -y @modelcontextprotocol/inspector@2.11.0 --cli node build/index.js --method tools/list"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chokidar": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.4"
  }
}
